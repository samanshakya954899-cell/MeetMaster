DATABASE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional integrations:
# OPENAI_API_KEY=
# RECALL_API_KEY=
# Direct backend SMTP delivery (optional; leave EMAIL_HOST unset for Supabase mail):
# SUPABASE_SECRET_KEY=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_SECONDS=60
